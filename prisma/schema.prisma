// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EmployeeRole {
  ADMIN
  EMPLOYEE
}

model EmployeeAccount {
  id                  String       @id @default(cuid())
  employeeId          String       @unique
  passwordHash        String
  role                EmployeeRole @default(EMPLOYEE)
  mustResetPassword   Boolean      @default(true)
  // Research session tracking â set on first login / once all 21 emails are opened.
  sessionStartedAt   DateTime?
  sessionCompletedAt DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  emails EmployeeEmail[]
}

// Read-only mirror of the HR system. Seeded/synced externally; never written by this app.
model HrEmployee {
  id         String   @id @default(cuid())
  employeeId String   @unique
  fullName   String
  email      String
  department String   @default("Retail Banking")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum EmailActionType {
  INFO
  LINK
  REPLY
  CREDENTIAL
  APPROVE
  ATTACHMENT
}

enum EmailActionStatus {
  NONE
  REPLIED
  DONE
  APPROVED
  DECLINED
  DOWNLOADING
  DOWNLOADED
  VERIFYING
  VERIFIED
}

// Content/template for a SETA phishing-awareness inbox message. Shared across
// all employees; per-employee read/response state lives on EmployeeEmail.
model InternalEmail {
  id             String          @id @default(cuid())
  // Fixed presentation order, identical for every participant. Never re-sorted at query time.
  sequenceNumber Int             @unique
  senderName     String
  senderEmail    String
  subject        String
  preview        String
  body           String
  tag            String
  actionType     EmailActionType @default(INFO)
  actionLabel    String?
  href           String?
  approveLabel   String?
  declineLabel   String?
  attachmentName String?
  attachmentSize String?
  replyPrompt    String?
  // Marks this template as a simulated phishing attempt for admin/research reporting only.
  // Never exposed through the employee-facing inbox API.
  isPhishing     Boolean         @default(false)
  // 'high' | 'medium' | 'low' contextualization â research metadata only, never shown to participants.
  phishingLevel  String?
  phishingNotes  String?
  sentAt         DateTime
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  deliveries EmployeeEmail[]
}

// ISP Self-Check quiz system.
model PolicyQuestion {
  id          String          @id @default(cuid())
  question    String
  explanation String?         // shown after the employee answers
  isActive    Boolean         @default(true)
  order       Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  choices     PolicyChoice[]
  attempts    PolicyAttempt[]
}

model PolicyChoice {
  id         String         @id @default(cuid())
  questionId String
  text       String
  isCorrect  Boolean        @default(false)
  order      Int            @default(0)
  question   PolicyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model PolicyAttempt {
  id          String         @id @default(cuid())
  employeeId  String
  questionId  String
  choiceId    String
  isCorrect   Boolean
  attemptedAt DateTime       @default(now())
  question    PolicyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

// Admin-uploaded documents (policies, training materials, guides, forms).
// Stored in public/documents/ and served as static files.
model Document {
  id          String   @id @default(cuid())
  title       String
  description String?
  category    String   @default("general")
  fileName    String
  storedName  String   @unique
  fileSize    Int
  mimeType    String
  uploadedBy  String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Employee-created discussion threads and replies for the collaborative forum.
model Discussion {
  id         String            @id @default(cuid())
  employeeId String
  authorName String
  title      String
  body       String
  category   String            @default("general")
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  replies    DiscussionReply[]
}

model DiscussionReply {
  id           String     @id @default(cuid())
  discussionId String
  employeeId   String
  authorName   String
  body         String
  createdAt    DateTime   @default(now())
  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
}

// Emoji reactions on discussions and replies.
// targetId is either a Discussion.id or DiscussionReply.id.
// One reaction per employee per target (unique constraint enforces toggle-replace behaviour).
model DiscussionReaction {
  id         String   @id @default(cuid())
  targetId   String
  targetType String   // "discussion" | "reply"
  employeeId String
  authorName String
  emoji      String
  createdAt  DateTime @default(now())

  @@unique([targetId, employeeId])
}

// One employee's copy of an InternalEmail, tracking whether they've read it,
// the research DVs (click / submit), and what action (if any) they took.
model EmployeeEmail {
  id           String            @id @default(cuid())
  employeeId   String
  emailId      String
  isRead       Boolean           @default(false)
  isArchived   Boolean           @default(false)
  actionStatus EmailActionStatus @default(NONE)
  actionText   String?
  actionAt     DateTime?
  // Research DVs â recorded independently of actionStatus so DV1/DV2 timing survives
  // regardless of which actionType the email uses.
  openedAt     DateTime?
  dv1ClickedAt DateTime?
  dv2SubmittedAt DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  employee EmployeeAccount @relation(fields: [employeeId], references: [employeeId])
  email    InternalEmail   @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@unique([employeeId, emailId])
}